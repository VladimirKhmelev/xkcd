{
    "swagger": "2.0",
    "info": {
        "description": "API for searching XKCD comics",
        "title": "XKCD Search API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:28080",
    "basePath": "/",
    "paths": {
        "/api/db": {
            "delete": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Delete all comics and words from the database, resets the search index and cache",
                "tags": [
                    "admin"
                ],
                "summary": "Drop database",
                "responses": {
                    "200": {
                        "description": "ok",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "internal server error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/db/stats": {
            "get": {
                "description": "Returns total and fetched comics count, total and unique words count",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "admin"
                ],
                "summary": "Database stats",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/rest.StatsResponse"
                        }
                    },
                    "500": {
                        "description": "internal server error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/db/status": {
            "get": {
                "description": "Returns current update status: idle or running",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "admin"
                ],
                "summary": "Update status",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/rest.StatusResponse"
                        }
                    },
                    "500": {
                        "description": "internal server error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/db/update": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Fetch new comics from xkcd.com and store them. Runs asynchronously — returns 202 if already running",
                "tags": [
                    "admin"
                ],
                "summary": "Update database",
                "responses": {
                    "200": {
                        "description": "ok",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "202": {
                        "description": "already running",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "internal server error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/isearch": {
            "get": {
                "description": "Search XKCD comics using in-memory index, faster but requires index to be built",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "search"
                ],
                "summary": "Index search",
                "parameters": [
                    {
                        "minLength": 1,
                        "type": "string",
                        "description": "Search phrase",
                        "name": "phrase",
                        "in": "query",
                        "required": true
                    },
                    {
                        "maximum": 100,
                        "minimum": 1,
                        "type": "integer",
                        "default": 10,
                        "description": "Max number of results",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/rest.SearchResponse"
                        }
                    },
                    "400": {
                        "description": "phrase is required",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "internal server error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/login": {
            "post": {
                "description": "Login with admin credentials (from env ADMIN_USER/ADMIN_PASSWORD), returns JWT token",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Admin login",
                "parameters": [
                    {
                        "description": "Admin credentials",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/rest.LoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "eyJhbGciOiJIUzI1NiJ9...",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "invalid request body",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/register": {
            "post": {
                "description": "Create a new user account with bcrypt-hashed password",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Register user",
                "parameters": [
                    {
                        "description": "New user credentials",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/rest.LoginRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "created",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "name and password are required",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "409": {
                        "description": "user already exists or internal error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/search": {
            "get": {
                "description": "Search XKCD comics by phrase using full-text search against the database",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "search"
                ],
                "summary": "Search comics",
                "parameters": [
                    {
                        "minLength": 1,
                        "type": "string",
                        "description": "Search phrase",
                        "name": "phrase",
                        "in": "query",
                        "required": true
                    },
                    {
                        "maximum": 100,
                        "minimum": 1,
                        "type": "integer",
                        "default": 10,
                        "description": "Max number of results",
                        "name": "limit",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/rest.SearchResponse"
                        }
                    },
                    "400": {
                        "description": "phrase is required",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "internal server error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/user/login": {
            "post": {
                "description": "Login with registered user credentials, returns JWT token valid for searching",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "text/plain"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "User login",
                "parameters": [
                    {
                        "description": "User credentials",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/rest.LoginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "eyJhbGciOiJIUzI1NiJ9...",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "invalid request body",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "rest.ComicsItem": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "integer",
                    "example": 353
                },
                "url": {
                    "type": "string",
                    "example": "https://imgs.xkcd.com/comics/python.png"
                }
            }
        },
        "rest.LoginRequest": {
            "description": "Login credentials for admin or user",
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1,
                    "example": "admin"
                },
                "password": {
                    "type": "string",
                    "minLength": 1,
                    "example": "password"
                }
            }
        },
        "rest.SearchResponse": {
            "type": "object",
            "properties": {
                "comics": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/rest.ComicsItem"
                    }
                },
                "total": {
                    "type": "integer",
                    "example": 5
                }
            }
        },
        "rest.StatsResponse": {
            "type": "object",
            "properties": {
                "comics_fetched": {
                    "type": "integer",
                    "example": 3241
                },
                "comics_total": {
                    "type": "integer",
                    "example": 3241
                },
                "words_total": {
                    "type": "integer",
                    "example": 148234
                },
                "words_unique": {
                    "type": "integer",
                    "example": 9412
                }
            }
        },
        "rest.StatusResponse": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "enum": [
                        "idle",
                        "running"
                    ],
                    "example": "idle"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}